GEMINI_API_KEY=replace_with_a_new_key
GEMINI_MODEL=gemini-2.0-flash
KRISHIVISION_MONGODB_URI=mongodb://localhost:27017/KrishiVisonDb
KRISHIVISION_MONGODB_DATABASE=KrishiVisonDb

# Auth
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
KRISHIVISION_JWT_SECRET=replace_with_a_long_random_secret
KRISHIVISION_TOKEN_EXPIRE_HOURS=168
KRISHIVISION_COOKIE_SECURE=false
KRISHIVISION_COOKIE_NAME=krishivision_token
# Any origin that may call this API (browser fetch with credentials).
# Do NOT use "*" together with credentialed requests.
KRISHIVISION_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
